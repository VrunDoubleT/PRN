<Window x:Class="ManageProduct.CreateProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ManageProduct"
        mc:Ignorable="d"
        Title="ADD NEW PRODUCT" Height="700" Width="500"
        MinHeight="700"
        MinWidth="500"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="ADD NEW PRODUCT" 
                   FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20" 
                   Foreground="#2C3E50"/>

        <!-- Product Title -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Title *" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox Name="txtTitle" Height="30" FontSize="12" 
                     BorderBrush="#BDC3C7" BorderThickness="1"/>
        </StackPanel>

        <!-- Description -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Description" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox Name="txtDescription" Height="80" FontSize="12" 
                     TextWrapping="Wrap" AcceptsReturn="True" 
                     VerticalScrollBarVisibility="Auto"
                     BorderBrush="#BDC3C7" BorderThickness="1"/>
        </StackPanel>

        <!-- Price -->
        <StackPanel Grid.Row="3" Margin="0,0,0,15">
            <TextBlock Text="Price (VNĐ) *" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox Name="txtPrice" Height="30" FontSize="12" 
                     BorderBrush="#BDC3C7" BorderThickness="1"/>
        </StackPanel>

        <!-- Stock Quantity -->
        <StackPanel Grid.Row="4" Margin="0,0,0,15">
            <TextBlock Text="Quantity *" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox Name="txtStockQuantity" Height="30" FontSize="12" 
                     BorderBrush="#BDC3C7" BorderThickness="1"/>
        </StackPanel>

        <!-- Category -->
        <StackPanel Grid.Row="5" Margin="0,0,0,15">
            <TextBlock Text="Category *" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox Name="cmbCategory" Height="30" FontSize="12"
                      DisplayMemberPath="CategoryName" 
                      SelectedValuePath="CategoryID"
                      BorderBrush="#BDC3C7" BorderThickness="1"/>
        </StackPanel>

        <!-- Brand -->
        <StackPanel Grid.Row="6" Margin="0,0,0,15">
            <TextBlock Text="Brand *" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox Name="cmbBrand" Height="30" FontSize="12"
                      DisplayMemberPath="BrandName" 
                      SelectedValuePath="BrandID"
                      BorderBrush="#BDC3C7" BorderThickness="1"/>
        </StackPanel>

        <!-- Image URL -->
        <StackPanel Grid.Row="7" Margin="0,0,0,15">
            <TextBlock Text="URL image" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Name="txtImageURL" Grid.Column="0" Height="30" FontSize="12" 
                         BorderBrush="#BDC3C7" BorderThickness="1"/>
                <Button Name="btnBrowseImage" Grid.Column="1" Content="Duyệt..." 
                        Width="60" Height="30" Margin="5,0,0,0"
                        Background="#3498DB" Foreground="White" 
                        BorderBrush="#2980B9" BorderThickness="1"
                        Click="BtnBrowseImage_Click"/>
            </Grid>
        </StackPanel>

        <!-- Required Fields Note -->
        <TextBlock Grid.Row="8" Text="* Require field" 
                   FontStyle="Italic" FontSize="10" 
                   Foreground="#E74C3C" 
                   VerticalAlignment="Top" Margin="0,10,0,0"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="9" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Name="btnSave" Content="Save" Width="100" Height="35" 
                    Background="#27AE60" Foreground="White" 
                    BorderBrush="#229954" BorderThickness="1"
                    FontSize="12" FontWeight="SemiBold" 
                    Margin="0,0,10,0" Click="BtnSave_Click"/>
            <Button Name="btnCancel" Content="Cancel" Width="100" Height="35" 
                    Background="#E74C3C" Foreground="White" 
                    BorderBrush="#C0392B" BorderThickness="1"
                    FontSize="12" FontWeight="SemiBold" 
                    Margin="10,0,0,0" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>