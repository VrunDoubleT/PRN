<Page x:Class="ManageProduct.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ManageProduct"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="Dashboard">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="0,0,12,12" Margin="10,0">
            <Grid Margin="30,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Dashboard Overview" 
                              FontSize="28" 
                              FontWeight="Bold" 
                              Foreground="White"/>
                    <TextBlock Text="System Statistics and Data Summary" 
                              FontSize="14" 
                              Foreground="#BDC3C7" 
                              Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Right" 
                           VerticalAlignment="Center">
                    <TextBlock x:Name="LastUpdatedText" 
                              Text="Last updated: Loading..." 
                              Foreground="#BDC3C7" 
                              FontSize="12" 
                              Margin="0,0,15,0"
                              VerticalAlignment="Center"/>
                    <Button Content="Refresh Data" 
                           Background="#3498DB" 
                           Foreground="White" 
                           Padding="15,8" 
                           BorderThickness="0" 
                           x:Name="RefreshButton" Click="RefreshButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" Margin="10" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Statistics Cards -->
                <Grid Margin="0,20,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Products Card -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Margin="5" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="📦" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock x:Name="TotalProductsText" 
                                      Text="0" 
                                      FontSize="36" 
                                      FontWeight="Bold" 
                                      Foreground="#3498DB" 
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="Total Products" 
                                      FontSize="14" 
                                      Foreground="#7F8C8D" 
                                      HorizontalAlignment="Center" 
                                      Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Categories Card -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" Margin="5" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="📂" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock x:Name="TotalCategoriesText" 
                                      Text="0" 
                                      FontSize="36" 
                                      FontWeight="Bold" 
                                      Foreground="#27AE60" 
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="Categories" 
                                      FontSize="14" 
                                      Foreground="#7F8C8D" 
                                      HorizontalAlignment="Center" 
                                      Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Brands Card -->
                    <Border Grid.Column="2" Background="White" CornerRadius="12" Margin="5" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="🏷️" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock x:Name="TotalBrandsText" 
                                      Text="0" 
                                      FontSize="36" 
                                      FontWeight="Bold" 
                                      Foreground="#F39C12" 
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="Brands" 
                                      FontSize="14" 
                                      Foreground="#7F8C8D" 
                                      HorizontalAlignment="Center" 
                                      Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Users Card -->
                    <Border Grid.Column="3" Background="White" CornerRadius="12" Margin="5" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="👥" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock x:Name="TotalUsersText" 
                                      Text="0" 
                                      FontSize="36" 
                                      FontWeight="Bold" 
                                      Foreground="#9B59B6" 
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="Users" 
                                      FontSize="14" 
                                      Foreground="#7F8C8D" 
                                      HorizontalAlignment="Center" 
                                      Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Stock Card -->
                    <Border Grid.Column="4" Background="White" CornerRadius="12" Margin="5" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="📊" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock x:Name="TotalStockText" 
                                      Text="0" 
                                      FontSize="36" 
                                      FontWeight="Bold" 
                                      Foreground="#E74C3C" 
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="Total Stock" 
                                      FontSize="14" 
                                      Foreground="#7F8C8D" 
                                      HorizontalAlignment="Center" 
                                      Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Details Section -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Top Categories -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Margin="5" Padding="25">
                        <Border.Effect>
                            <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Top Categories by Product Count" 
                                      FontSize="18" 
                                      FontWeight="Bold" 
                                      Foreground="#2C3E50" 
                                      Margin="0,0,0,20"/>
                            <DataGrid x:Name="TopCategoriesGrid"
                                     AutoGenerateColumns="False" 
                                     CanUserAddRows="False"
                                     CanUserDeleteRows="False"
                                     CanUserReorderColumns="False"
                                     CanUserResizeColumns="False"
                                     CanUserSortColumns="False"
                                     IsReadOnly="True"
                                     GridLinesVisibility="None"
                                     HeadersVisibility="Column"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     RowBackground="Transparent"
                                     AlternatingRowBackground="#F8F9FA">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Category" Binding="{Binding Name}" Width="*">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#ECF0F1"/>
                                                <Setter Property="Foreground" Value="#2C3E50"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Padding" Value="10"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Products" Binding="{Binding ProductCount}" Width="100">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#ECF0F1"/>
                                                <Setter Property="Foreground" Value="#2C3E50"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Padding" Value="10"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Top Brands -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" Margin="5" Padding="25">
                        <Border.Effect>
                            <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Top Brands by Product Count" 
                                      FontSize="18" 
                                      FontWeight="Bold" 
                                      Foreground="#2C3E50" 
                                      Margin="0,0,0,20"/>
                            <DataGrid x:Name="TopBrandsGrid"
                                     AutoGenerateColumns="False" 
                                     CanUserAddRows="False"
                                     CanUserDeleteRows="False"
                                     CanUserReorderColumns="False"
                                     CanUserResizeColumns="False"
                                     CanUserSortColumns="False"
                                     IsReadOnly="True"
                                     GridLinesVisibility="None"
                                     HeadersVisibility="Column"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     RowBackground="Transparent"
                                     AlternatingRowBackground="#F8F9FA">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Brand" Binding="{Binding Name}" Width="*">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#ECF0F1"/>
                                                <Setter Property="Foreground" Value="#2C3E50"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Padding" Value="10"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Products" Binding="{Binding ProductCount}" Width="100">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#ECF0F1"/>
                                                <Setter Property="Foreground" Value="#2C3E50"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Padding" Value="10"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Additional Statistics -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- User Roles Distribution -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Margin="5" Padding="25">
                        <Border.Effect>
                            <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="User Roles Distribution" 
                                      FontSize="18" 
                                      FontWeight="Bold" 
                                      Foreground="#2C3E50" 
                                      Margin="0,0,0,20"/>
                            <DataGrid x:Name="RolesDistributionGrid"
                                     AutoGenerateColumns="False" 
                                     CanUserAddRows="False"
                                     CanUserDeleteRows="False"
                                     CanUserReorderColumns="False"
                                     CanUserResizeColumns="False"
                                     CanUserSortColumns="False"
                                     IsReadOnly="True"
                                     GridLinesVisibility="None"
                                     HeadersVisibility="Column"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     RowBackground="Transparent"
                                     AlternatingRowBackground="#F8F9FA">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Role" Binding="{Binding Name}" Width="*">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#ECF0F1"/>
                                                <Setter Property="Foreground" Value="#2C3E50"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Padding" Value="10"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Users" Binding="{Binding ProductCount}" Width="80">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#ECF0F1"/>
                                                <Setter Property="Foreground" Value="#2C3E50"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Padding" Value="10"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Price Statistics -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" Margin="5" Padding="25">
                        <Border.Effect>
                            <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Product Price Statistics" 
                                      FontSize="18" 
                                      FontWeight="Bold" 
                                      Foreground="#2C3E50" 
                                      Margin="0,0,0,20"/>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Average Price:" FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AvgPriceText" Text="$0.00" FontWeight="Bold" Foreground="#3498DB" Margin="0,5"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Minimum Price:" FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="MinPriceText" Text="$0.00" FontWeight="Bold" Foreground="#27AE60" Margin="0,5"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Maximum Price:" FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="MaxPriceText" Text="$0.00" FontWeight="Bold" Foreground="#E74C3C" Margin="0,5"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Total Value:" FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TotalValueText" Text="$0.00" FontWeight="Bold" Foreground="#F39C12" Margin="0,5"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>