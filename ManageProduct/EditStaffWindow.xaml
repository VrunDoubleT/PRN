<Window x:Class="ManageProduct.EditStaffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EDIT STAFF"
        Height="400"
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        Background="#F8F9FA">
    <Window.Resources>
        <!-- Reuse button and shadow styles from your category dialog -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="66"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#bdc3c7"/>
            <Setter Property="Foreground" Value="#2d3436"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="66"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DropShadowEffect x:Key="CardShadow" Color="Gray" Direction="270" ShadowDepth="2" Opacity="0.13" BlurRadius="16"/>
    </Window.Resources>

    <Border CornerRadius="12" Background="White" Padding="30" Effect="{StaticResource CardShadow}" Height="400" VerticalAlignment="Top">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" Text="EDIT STAFF" 
                   FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20" 
                   Foreground="#2C3E50"/>

            <!-- Full Name -->
            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <TextBlock Text="Full Name *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtFullName" Height="30" FontSize="12" 
                     BorderBrush="#BDC3C7" BorderThickness="1"/>
            </StackPanel>

            <!-- Email -->
            <StackPanel Grid.Row="2" Margin="0,0,0,15">
                <TextBlock Text="Email *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtEmail" Height="30" FontSize="12" 
                     BorderBrush="#BDC3C7" BorderThickness="1"/>
            </StackPanel>

            <!-- Required Fields Note -->
            <TextBlock Grid.Row="3" Text="* Require field" 
                   FontStyle="Italic" FontSize="10" 
                   Foreground="#E74C3C" 
                   VerticalAlignment="Top" Margin="0,10,0,0"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Name="btnSave" Content="Save" Width="100" Height="35" 
                    Background="#27AE60" Foreground="White" 
                    BorderBrush="#229954" BorderThickness="1"
                    FontSize="12" FontWeight="SemiBold" 
                    Margin="0,0,10,0" Click="BtnSave_Click"/>
                <Button Name="btnCancel" Content="Cancel" Width="100" Height="35" 
                    Background="#E74C3C" Foreground="White" 
                    BorderBrush="#C0392B" BorderThickness="1"
                    FontSize="12" FontWeight="SemiBold" 
                    Margin="10,0,0,0" Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
